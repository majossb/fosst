# ==============================================================================
# FOSST V.I.D.A. — AMBIENTE UAT (User Acceptance Testing)
# Plantilla de Variables de Entorno para el servidor UAT (Render / Docker / VPS)
# ==============================================================================
# INSTRUCCIONES: Configurar estos valores en las variables de entorno de la plataforma.
# NUNCA guardar claves reales, contraseñas o secretos en el repositorio Git.

# ── Configuración General del Entorno Django ─────────────────────────────────
ENVIRONMENT=uat
DEBUG=False
DJANGO_SECRET_KEY=generar-clave-aleatoria-robusta-minimo-50-caracteres-uat
JWT_SECRET=generar-otra-clave-aleatoria-diferente-firmado-jwt-uat
ALLOWED_HOSTS=uat-api.fosstvida.com,uat-app.fosstvida.com

# ── Base de Datos PostgreSQL UAT (Aislada de DEV) ────────────────────────────
DATABASE_URL=postgres://fosst_uat_user:PasswordSeguraUAT2026@dpg-xxxxxx-a.rendercom:5432/fosst_uat_db
DB_CONN_MAX_AGE=600

# ── Redis UAT (Aislado de DEV) ───────────────────────────────────────────────
REDIS_URL=rediss://default:PasswordRedisUAT2026@red-xxxxxx.rendercom:6379/1

# ── Almacenamiento Persistente de Evidencias S3 / Cloudflare R2 ─────────────
STORAGE_BACKEND=storages.backends.s3.S3Storage
AWS_ACCESS_KEY_ID=AKIAUATSECRETKEYID123
AWS_SECRET_ACCESS_KEY=SecretAccessKeyRealDeS3CloudflareR2
AWS_STORAGE_BUCKET_NAME=fosst-evidencias-uat
AWS_S3_REGION_NAME=us-east-1
# Descomentar si utiliza Cloudflare R2, MinIO remoto o CDN personalizado:
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=cdn-uat.fosstvida.com

# ── Configuración de Seguridad, CORS, CSRF y Dominios Públicos HTTPS ────────
FRONTEND_URL=https://uat-app.fosstvida.com
CORS_ALLOWED_ORIGINS=https://uat-app.fosstvida.com
CSRF_TRUSTED_ORIGINS=https://uat-app.fosstvida.com,https://uat-api.fosstvida.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# ── SMTP Real para Envío de Correos y Notificaciones ─────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=notificaciones@fosstvida.com
EMAIL_HOST_PASSWORD=smtp_api_key_real_del_proveedor
DEFAULT_FROM_EMAIL=FOSST V.I.D.A. UAT <no-reply@fosstvida.com>
SERVER_EMAIL=FOSST V.I.D.A. UAT Alertas <alertas-uat@fosstvida.com>
EMAIL_TIMEOUT=30

# ── Parámetros de Seguridad y Reset ──────────────────────────────────────────
ALLOW_UAT_RESET=false
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv

# ── Inteligencia Artificial Generativa (Opcional - Fase 2) ───────────────────
ANTHROPIC_API_KEY=sk-ant-api-key-real-si-aplica
